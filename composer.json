{
    "name": "karelialabs/statamic-conversions",
    "description": "Server-side conversion tracking for Statamic: send form leads, sign-ups and orders to the Meta Conversions API, Google Analytics 4 and TikTok, with consent and click IDs.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": ["statamic", "statamic-addon", "conversions api", "meta pixel", "facebook capi", "ga4", "measurement protocol", "tiktok events api", "server-side tracking", "utm", "gclid", "fbclid"],
    "homepage": "https://karelialabs.com/platforms/statamic",
    "authors": [
        {
            "name": "Karelia Labs",
            "homepage": "https://karelialabs.com"
        }
    ],
    "support": {
        "email": "support@karelialabs.atlassian.net",
        "docs": "https://ziroxonline111.github.io/karelia-labs/products/karelia-conversions/docs/"
    },
    "autoload": {
        "psr-4": {
            "KareliaLabs\\Conversions\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KareliaLabs\\Conversions\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.20"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Karelia Conversions",
            "description": "Server-side conversion tracking: send leads, sign-ups and orders to Meta, GA4 and TikTok from your server, with consent and click IDs."
        },
        "laravel": {
            "providers": [
                "KareliaLabs\\Conversions\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
